# Local: omite TURSO_DATABASE_URL para usar file:local.db.
# Vercel: configura ambas variables con una base Turso remota distinta de la landing.
TURSO_DATABASE_URL=libsql://tu-base.turso.io
TURSO_AUTH_TOKEN=tu_token
PORT=5174
VITE_GOOGLE_CLIENT_ID=tu_cliente_web.apps.googleusercontent.com
# El mismo ID, usado únicamente por el backend para validar tokens.
GOOGLE_CLIENT_ID=tu_cliente_web.apps.googleusercontent.com

# Avisos de recojo: genera el par una sola vez con `npx web-push generate-vapid-keys`.
# Usa las mismas claves en todos los despliegues para no invalidar suscripciones.
# VAPID_PUBLIC_KEY=...
# VAPID_PRIVATE_KEY=...
# VAPID_SUBJECT=mailto:tu-correo@utec.edu.pe
# CRON_SECRET=una_clave_aleatoria_de_al_menos_24_caracteres
